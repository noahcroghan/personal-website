{
  "name": "personal-website",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && shx cp -r functions dist/",
    "preview": "bun run build && vite preview",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "format": "stylelint \"**/*.css\" --fix && prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun --bun eslint . && bun run lint:md && bun run lint:css",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:css": "stylelint \"**/*.css\"",
    "spotify:auth": "bun scripts/spotify-auth.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "shx": "^0.4.0",
    "stylelint": "^18.0.0",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.2"
  }
}
